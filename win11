SELF="$(realpath "$0")"
VERSION="2.0"
REMOTE_URL="https://raw.githubusercontent.com/franc417/win11/main/win11"

# Official Microsoft SHA256 — Windows 11 24H2 English x64
OFFICIAL_SHA256="B56B911BF18A2CEAEB3904D87E7C770BDF92D3099599D61AC2497B91BF190B11"
# Expected full ISO size in bytes (~5.4 GiB)
ISO_FULL_SIZE=5802987520

# aria2c options
ARIA2_OPTS=(
    --continue=true
    --max-connection-per-server=16
    --split=16
    --min-split-size=5M
    --file-allocation=none
    --save-session="${ARIA2_SESSION}"
    --save-session-interval=5
    --console-log-level=warn
    --summary-interval=1
    --max-tries=0
    --retry-wait=10
    --connect-timeout=30
    --timeout=60
    --http-accept-gzip=true
    --auto-file-renaming=false
    --allow-overwrite=false
    --out="Win11_24H2_English_x64.iso"
    --dir="${WIN11_DIR}"
    --log="${LOG_FILE}"
    --log-level=warn
)

