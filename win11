    fi
    save_url "$url"
    echo "$url"
}

# ── Download worker (runs inside tmux) ───────────────────────────
do_download() {
    local url
    url=$(load_url)
    [[ -z "$url" ]] && { printf "${R}  ✗ No URL. Run win11 again.${N}\n"; write_status "IDLE"; exit 1; }

    write_status "DOWNLOADING"
    date +%s > "$START_FILE"
    mkdir -p "$WIN11_DIR"

    printf "\n${C}  aria2c starting — 16 connections, auto-resume enabled${N}\n"
    printf "${D}  Log: %s${N}\n\n" "$LOG_FILE"

    local -a extra=()
    # Resume from session file if it exists
    [[ -f "$ARIA2_SESSION" ]] && extra+=(--input-file="$ARIA2_SESSION")

    # aria2c exits non-zero on interrupt — we catch it and mark INTERRUPTED
    # It will NOT be called HASH_FAIL just from a disconnect
    aria2c "${ARIA2_OPTS[@]}" "${extra[@]}" "$url"
    local exit_code=$?

    if [[ ! -f "$ISO_FILE" ]]; then
        write_status "INTERRUPTED"
        printf "\n${Y}  ⚠ No ISO file found. Marked as interrupted.${N}\n"
        return
    fi

    local sz
    sz=$(stat -c%s "$ISO_FILE" 2>/dev/null || echo 0)

    # Only verify SHA256 if the file is complete (within 1MB of expected size)
    local size_diff=$(( ISO_FULL_SIZE - sz ))
    [[ $size_diff -lt 0 ]] && size_diff=$(( -size_diff ))

    if (( size_diff < 1048576 )); then
        # File looks complete — verify
        write_status "VERIFYING"
        printf "\n${Y}  ══ Download complete. Verifying SHA256 (~30s)... ══${N}\n"
        local computed
        computed=$(sha256sum "$ISO_FILE" | awk '{print toupper($1)}')
        if [[ "$computed" == "$OFFICIAL_SHA256" ]]; then
            write_status "VERIFIED_OK"
            rm -f "$ARIA2_SESSION"  # clean up session file on success
            printf "${G}  ✔ SHA256 MATCH — ISO is authentic and uncorrupted${N}\n"
            printf "${G}  ✔ Saved to: %s${N}\n" "$ISO_FILE"
        else
            write_status "HASH_FAIL"
            printf "${R}  ✗ SHA256 MISMATCH${N}\n"
            printf "${R}  Expected : %s${N}\n" "$OFFICIAL_SHA256"
            printf "${R}  Got      : %s${N}\n" "$computed"
            printf "${Y}  Tip: If you used a non-English ISO link the hash will differ.${N}\n"
            printf "${Y}  Run: win11 verify  (just checks hash, doesn't re-download)${N}\n"
        fi
    elif (( exit_code != 0 )); then
        # aria2c was interrupted (network drop, manual stop, etc.)
        write_status "INTERRUPTED"
        printf "\n${Y}  ⚠ Download interrupted at %s / %s${N}\n" \
            "$(human_bytes "$sz")" "$(human_bytes "$ISO_FULL_SIZE")"
        printf "${Y}  Session saved. Run ${W}win11${Y} to resume automatically.${N}\n"
    else
        write_status "INTERRUPTED"
        printf "\n${Y}  ⚠ Download incomplete (%s). Run win11 to resume.${N}\n" \
            "$(human_bytes "$sz")"
    fi
}

# ── Parse aria2c log for live stats ──────────────────────────────
parse_aria2_stats() {
    # Returns: downloaded_bytes speed_bytes eta_seconds connections
    local log="$LOG_FILE"
    local downloaded=0 speed=0 eta=0 connections=0

    if [[ -f "$log" ]]; then
        # Get last summary line from aria2c log
        local last_line
        last_line=$(grep -a 'DL:' "$log" 2>/dev/null | tail -1 || echo "")
        if [[ -n "$last_line" ]]; then
            # Extract speed (DL:XXXKiB or DL:XXXMiB)
            local spd_str
            spd_str=$(echo "$last_line" | grep -oP 'DL:\K[0-9]+[KMG]iB' || echo "")
            if [[ -n "$spd_str" ]]; then
                local num unit
                num=$(echo "$spd_str" | grep -oP '[0-9]+')
                unit=$(echo "$spd_str" | grep -oP '[KMG]iB')
                case "$unit" in
                    KiB) speed=$(( num * 1024 )) ;;
                    MiB) speed=$(( num * 1048576 )) ;;
                    GiB) speed=$(( num * 1073741824 )) ;;
                esac
            fi
            # Extract connections (CN:XX)
            connections=$(echo "$last_line" | grep -oP 'CN:\K[0-9]+' || echo "0")
            # Extract ETA
            local eta_str
            eta_str=$(echo "$last_line" | grep -oP 'ETA:\K[0-9hms]+' || echo "")
            if [[ -n "$eta_str" ]]; then
                local h=0 m=0 s=0
                [[ "$eta_str" =~ ([0-9]+)h ]] && h=${BASH_REMATCH[1]}
                [[ "$eta_str" =~ ([0-9]+)m ]] && m=${BASH_REMATCH[1]}
                [[ "$eta_str" =~ ([0-9]+)s ]] && s=${BASH_REMATCH[1]}
                eta=$(( h*3600 + m*60 + s ))
            fi
        fi
    fi

    # Get actual file size
    if [[ -f "$ISO_FILE" ]]; then
        downloaded=$(stat -c%s "$ISO_FILE" 2>/dev/null || echo 0)
    fi

    echo "$downloaded $speed $eta $connections"
}

# ── Rich status display ───────────────────────────────────────────
show_progress() {
    local status
    status=$(read_status)
    local saved_url
    saved_url=$(load_url)
    local now; now=$(date +%s)
    local start_time=0
    [[ -f "$START_FILE" ]] && start_time=$(cat "$START_FILE" 2>/dev/null || echo 0)
    local elapsed=$(( now - start_time ))
    [[ $elapsed -lt 0 ]] && elapsed=0

    clear_screen
    print_banner

    printf "${W}  ┌─ Download Status ───────────────────────────────────────────┐${N}\n"

    case "$status" in
        IDLE)
            printf "  │\n"
            printf "  │  ${D}Status :${N}  ${Y}Idle${N}\n"
            printf "  │  ${D}Action :${N}  run ${W}win11${N} to start\n"
            printf "  │\n"
            ;;

        DOWNLOADING)
            read -r dl speed eta conns <<< "$(parse_aria2_stats)"
            local pct=0
            (( ISO_FULL_SIZE > 0 && dl > 0 )) && pct=$(( dl * 100 / ISO_FULL_SIZE ))
            (( pct > 100 )) && pct=100

            local remaining=$(( ISO_FULL_SIZE - dl ))
            [[ $remaining -lt 0 ]] && remaining=0

            # Elapsed time
            local elapsed_str="--"
            (( start_time > 0 )) && elapsed_str=$(human_time "$elapsed")

            # Avg speed
            local avg_speed=0
            (( elapsed > 0 && dl > 0 )) && avg_speed=$(( dl / elapsed ))

            printf "  │\n"
            printf "  │  ${D}Status     :${N}  ${C}● Downloading${N}\n"
            printf "  │  ${D}Progress   :${N}  ${W}%3d%%${N}  —  %s  /  %s\n" \
                "$pct" "$(human_bytes "$dl")" "$(human_bytes "$ISO_FULL_SIZE")"
            printf "  │  ${D}Remaining  :${N}  %s\n" "$(human_bytes "$remaining")"
            printf "  │\n"
            printf "  │  "
            draw_bar "$pct" 50
            printf "\n"
            printf "  │\n"
            printf "  │  ${D}Speed      :${N}  ${G}%s${N}  ${D}(avg: %s)${N}\n" \
                "$(human_speed "$speed")" "$(human_speed "$avg_speed")"
            printf "  │  ${D}ETA        :${N}  %s\n" "$(human_time "$eta")"
            printf "  │  ${D}Elapsed    :${N}  %s\n" "$elapsed_str"
            printf "  │  ${D}Connections:${N}  ${W}%s${N} / 16\n" "$conns"
            printf "  │\n"
            printf "  │  ${D}Live view  :${N}  ${W}win11 attach${N}\n"
            printf "  │  ${D}Session    :${N}  tmux '%s'\n" "$SESSION_NAME"
            printf "  │\n"
            ;;

        VERIFYING)
            printf "  │\n"
            printf "  │  ${D}Status :${N}  ${Y}⟳ Running SHA256 verification...${N}\n"
            printf "  │  ${D}Note   :${N}  this takes ~30 seconds\n"
            printf "  │\n"
            ;;

        VERIFIED_OK)
            local sz; sz=$(stat -c%s "$ISO_FILE" 2>/dev/null || echo 0)
            printf "  │\n"
            printf "  │  ${D}Status  :${N}  ${G}${BOLD}✔ Complete & Verified${N}\n"
            printf "  │  ${D}File    :${N}  ${W}%s${N}\n" "$ISO_FILE"
            printf "  │  ${D}Size    :${N}  %s\n" "$(human_bytes "$sz")"
            printf "  │  ${D}SHA256  :${N}  ${G}✔ Matches official Microsoft hash${N}\n"
            printf "  │\n"
            printf "  │  ${G}  ISO is safe to burn or mount!${N}\n"
            printf "  │\n"
            ;;

        HASH_FAIL)
            printf "  │\n"
            printf "  │  ${D}Status :${N}  ${R}✗ SHA256 mismatch${N}\n"
            printf "  │  ${D}Fix    :${N}  run ${W}win11 verify${N} to re-check\n"
            printf "  │           or ${W}win11 clean${N} + fresh link to re-download\n"
            printf "  │\n"
            ;;

        INTERRUPTED)
            local sz=0
            [[ -f "$ISO_FILE" ]] && sz=$(stat -c%s "$ISO_FILE" 2>/dev/null || echo 0)
            local pct=0
            (( ISO_FULL_SIZE > 0 && sz > 0 )) && pct=$(( sz * 100 / ISO_FULL_SIZE ))
            printf "  │\n"
            printf "  │  ${D}Status    :${N}  ${Y}⚠ Interrupted (network drop or manual stop)${N}\n"
            printf "  │  ${D}Saved     :${N}  %s  (%d%%)\n" "$(human_bytes "$sz")" "$pct"
            printf "  │\n"
            printf "  │  "
            draw_bar "$pct" 50
            printf "\n"
            printf "  │\n"
            if [[ -n "$saved_url" ]]; then
                printf "  │  ${D}Resume    :${N}  run ${W}win11${N} — URL & session auto-reused\n"
            else
                printf "  │  ${D}Resume    :${N}  run ${W}win11${N} and paste a fresh link\n"
            fi
            printf "  │\n"
            ;;
    esac

    printf "${W}  └─────────────────────────────────────────────────────────────┘${N}\n\n"
    printf "  ${D}Version: v%s  •  win11 help for all commands${N}\n\n" "$VERSION"
}

# ── Subcommands ───────────────────────────────────────────────────
cmd_attach() {
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        printf "${C}  Attaching... (detach: Ctrl+B then D)${N}\n\n"
        sleep 0.3
        tmux attach -t "$SESSION_NAME"
    else
        printf "${Y}  No active session. Run ${W}win11${Y} to start.${N}\n\n"
    fi
}

cmd_verify() {
    [[ ! -f "$ISO_FILE" ]] && { printf "${R}  ✗ ISO not found: %s${N}\n\n" "$ISO_FILE"; exit 1; }
    local sz; sz=$(stat -c%s "$ISO_FILE" 2>/dev/null || echo 0)
    printf "\n${C}  File  : %s${N}\n" "$ISO_FILE"
    printf "${C}  Size  : %s${N}\n" "$(human_bytes "$sz")"
    printf "${C}  Verifying SHA256 (~30s)...${N}\n\n"
    local computed
    computed=$(sha256sum "$ISO_FILE" | awk '{print toupper($1)}')
    printf "  Computed : ${W}%s${N}\n" "$computed"
    printf "  Expected : ${W}%s${N}\n" "$OFFICIAL_SHA256"
    if [[ "$computed" == "$OFFICIAL_SHA256" ]]; then
        printf "\n  ${G}${BOLD}✔ MATCH — ISO is authentic and safe to use${N}\n\n"
        write_status "VERIFIED_OK"
    else
        local size_diff=$(( ISO_FULL_SIZE - sz ))
        [[ $size_diff -lt 0 ]] && size_diff=$(( -size_diff ))
        if (( size_diff > 1048576 )); then
            printf "\n  ${Y}  File is incomplete (%s / %s) — resume download first${N}\n\n" \
                "$(human_bytes "$sz")" "$(human_bytes "$ISO_FULL_SIZE")"
        else
            printf "\n  ${R}${BOLD}✗ MISMATCH — ISO may be corrupted or wrong edition${N}\n\n"
            write_status "HASH_FAIL"
        fi
    fi
}

cmd_stop() {
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        tmux kill-session -t "$SESSION_NAME"
        write_status "INTERRUPTED"
        printf "${Y}  ⚠ Paused. Session file saved.${N}\n"
        printf "${Y}  Run ${W}win11${Y} to resume automatically.${N}\n\n"
    else
        printf "${D}  No active session.${N}\n\n"
    fi
}

cmd_kill() {
    local killed=0
    # Kill named session
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        tmux kill-session -t "$SESSION_NAME"
        (( killed++ ))
    fi
    # Kill any other win11 related sessions
    while IFS= read -r sess; do
        [[ "$sess" == *"win11"* ]] && tmux kill-session -t "$sess" 2>/dev/null && (( killed++ ))
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)

    # Kill any aria2c processes
    pkill -f "aria2c.*Win11" 2>/dev/null && (( killed++ )) || true

    write_status "INTERRUPTED"
    if (( killed > 0 )); then
        printf "${R}  ✗ Killed %d session(s). Download stopped.${N}\n" "$killed"
        printf "${Y}  Run ${W}win11${Y} to resume.${N}\n\n"
    else
        printf "${D}  Nothing to kill.${N}\n\n"
    fi
}

cmd_clean() {
    printf "${Y}  This will delete the partial ISO and all session files.${N}\n"
    printf "${Y}  Are you sure? [y/N] ${N}"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        cmd_kill 2>/dev/null || true
        rm -f "$ISO_FILE" "${ISO_FILE}.aria2" "$ARIA2_SESSION" \
              "$LOG_FILE" "$URL_FILE" "$START_FILE"
        write_status "IDLE"
        printf "${G}  ✔ Cleaned. Run ${W}win11${G} to start fresh.${N}\n\n"
    else
        printf "${D}  Cancelled.${N}\n\n"
    fi
}

