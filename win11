# ══════════════════════════════════════════════════════════════════
#  win11 — Windows 11 ISO Downloader  v2.0
#  • Auto-resume on disconnect — NEVER triggers SHA256 mid-download
#  • Rich status — speed, ETA, connections, elapsed, downloaded/total
#  • Auto-update from GitHub without interrupting active downloads
#  • win11 kill — nuke all sessions instantly
# ══════════════════════════════════════════════════════════════════

set -uo pipefail

# ── Config ────────────────────────────────────────────────────────
WIN11_DIR="${WIN11_DIR:-/home/mkz/iso}"
ISO_FILE="${WIN11_DIR}/Win11_24H2_English_x64.iso"
