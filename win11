# ── Internal worker (called from inside tmux) ─────────────────────
[[ "${1:-}" == "--worker" ]] && { do_download; exit 0; }

# ── Main ──────────────────────────────────────────────────────────
main() {
    case "${1:-}" in
        status)         show_progress; exit 0 ;;
        attach)         cmd_attach; exit 0 ;;
        verify)         check_deps; cmd_verify; exit 0 ;;
        stop)           cmd_stop; exit 0 ;;
        kill)           cmd_kill; exit 0 ;;
        clean)          cmd_clean; exit 0 ;;
        update)         cmd_update; exit 0 ;;
        help|-h|--help) cmd_help; exit 0 ;;
    esac

    check_deps

    # Auto-update silently — skip if download already running
    if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        cmd_update --silent
    fi

    clear_screen
    print_banner
    mkdir -p "$WIN11_DIR"

    local status; status=$(read_status)

    # Already done?
    if [[ "$status" == "VERIFIED_OK" ]]; then
        show_progress
        printf "  ISO already complete and verified.\n"
        printf "  Use ${W}win11 clean${N} to re-download.\n\n"
        exit 0
    fi

    # Already running?
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        show_progress
        printf "  ${C}Download already running in background.${N}\n"
        printf "  ${W}win11 attach${N} to watch  •  ${W}win11 status${N} to check  •  ${W}win11 kill${N} to stop\n\n"
        exit 0
    fi

    # Determine URL
    local url=""
    local saved_url
    saved_url=$(load_url)

    if [[ -n "$saved_url" && ( "$status" == "INTERRUPTED" || "$status" == "DOWNLOADING" ) ]]; then
        printf "  ${Y}Resuming previous download automatically.${N}\n"
        printf "  ${D}Saved URL and session file will be reused.${N}\n"
        printf "  ${D}Press Enter to continue or type 'new' for a fresh link: ${N}"
        read -r choice
        if [[ "$choice" == "new" ]]; then
            url=$(prompt_for_url)
            rm -f "$ARIA2_SESSION"  # clear old session for fresh URL
        else
            url="$saved_url"
            printf "\n"
        fi
    else
        url=$(prompt_for_url)
    fi

    printf "  ${D}Destination :${N} ${W}%s${N}\n" "$ISO_FILE"
    printf "  ${D}Connections :${N} ${W}16 parallel (aria2c)${N}\n"
    printf "  ${D}Session     :${N} ${W}tmux '%s'${N}\n" "$SESSION_NAME"
    printf "  ${D}Resume      :${N} ${W}automatic on any interruption${N}\n\n"

    # Launch worker in detached tmux
    if tmux new-session -d -s "$SESSION_NAME" "bash '$SELF' --worker; exec bash"; then
        write_status "DOWNLOADING"
        date +%s > "$START_FILE"
        printf "  ${G}✔ Download started in background!${N}\n\n"
        printf "  ${W}win11 status${N}   — rich progress bar\n"
        printf "  ${W}win11 attach${N}   — live aria2c output\n"
        printf "  ${W}win11 stop${N}     — pause (resumes automatically later)\n"
        printf "  ${W}win11 kill${N}     — force stop everything\n\n"
        sleep 2
        show_progress
    else
        printf "  ${R}✗ tmux failed — running in foreground${N}\n\n"
        do_download
    fi
}

main "$@"
