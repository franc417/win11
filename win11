# ── Helpers ───────────────────────────────────────────────────────
human_bytes() {
    local b="${1:-0}"
    if   (( b >= 1073741824 )); then awk "BEGIN{printf \"%.2f GiB\", $b/1073741824}"
    elif (( b >= 1048576    )); then awk "BEGIN{printf \"%.1f MiB\", $b/1048576}"
    elif (( b >= 1024       )); then awk "BEGIN{printf \"%.1f KiB\", $b/1024}"
    else printf "%d B" "$b"
    fi
}

human_speed() {
    local b="${1:-0}"
    if   (( b >= 1048576 )); then awk "BEGIN{printf \"%.1f MB/s\", $b/1048576}"
    elif (( b >= 1024    )); then awk "BEGIN{printf \"%.1f KB/s\", $b/1024}"
    else printf "%d B/s" "$b"
    fi
}

human_time() {
    local s="${1:-0}"
    local h=$(( s / 3600 )) m=$(( (s % 3600) / 60 )) sec=$(( s % 60 ))
    if (( h > 0 )); then printf "%dh %dm %ds" "$h" "$m" "$sec"
    elif (( m > 0 )); then printf "%dm %ds" "$m" "$sec"
    else printf "%ds" "$sec"
    fi
}

draw_bar() {
    local pct=${1:-0} width=${2:-50}
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    printf "${G}"
    local i; for (( i=0; i<filled; i++ )); do printf "█"; done
    printf "${D}"
    for (( i=0; i<empty; i++ )); do printf "░"; done
    printf "${N}"
}

write_status() { echo "$1" > "$STATUS_FILE"; }
read_status()  { cat "$STATUS_FILE" 2>/dev/null || echo "IDLE"; }
save_url()     { echo "$1" > "$URL_FILE"; }
load_url()     { cat "$URL_FILE" 2>/dev/null || echo ""; }

check_deps() {
    local missing=()
    for cmd in aria2c sha256sum tmux curl; do
        command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        printf "\n${R}  ✗ Missing:${N} ${missing[*]}\n"
        printf "${Y}  Fix:${N} apt install aria2 tmux curl coreutils\n\n"
        exit 1
    fi
}

# ── Auto-update ───────────────────────────────────────────────────
# Fetches latest script from GitHub, replaces itself, re-execs
# Safe: never runs during an active download worker session
cmd_update() {
    local silent="${1:-}"
    [[ "$silent" != "--silent" ]] && printf "\n${C}  Checking for updates...${N}\n"
    local tmp
    tmp=$(mktemp)
    if curl -fsSL --max-time 10 "$REMOTE_URL" -o "$tmp" 2>/dev/null; then
        local remote_ver
        remote_ver=$(grep '^VERSION=' "$tmp" 2>/dev/null | cut -d'"' -f2 || echo "")
        if [[ -n "$remote_ver" && "$remote_ver" != "$VERSION" ]]; then
            chmod +x "$tmp"
            cp "$tmp" "$SELF"
            rm -f "$tmp"
            printf "  ${G}✔ Updated to v%s — re-launching${N}\n\n" "$remote_ver"
            sleep 1
            exec "$SELF" "$@"
        elif [[ -z "$remote_ver" ]]; then
            # Silently replace anyway (corrupted version line)
            chmod +x "$tmp"
            cp "$tmp" "$SELF"
            rm -f "$tmp"
        else
            rm -f "$tmp"
            [[ "$silent" != "--silent" ]] && printf "  ${G}✔ Already up to date (v%s)${N}\n\n" "$VERSION"
        fi
    else
        rm -f "$tmp"
        [[ "$silent" != "--silent" ]] && printf "  ${Y}  Could not reach GitHub — skipping update${N}\n\n"
    fi
}

